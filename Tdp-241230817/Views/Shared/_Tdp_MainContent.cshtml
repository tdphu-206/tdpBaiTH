@model IEnumerable<HangHoa>

<div class="content_top">
    <div class="heading">
        <h3>@ViewData["TieuDe"]</h3>
    </div>
    <div class="see">
        <p><a asp-controller="HangHoa" asp-action="Create">Thêm hàng hóa mới</a></p>
    </div>
    <div class="clear"></div>
</div>

@if (!Model.Any())
{
    <p style="padding:20px">Chưa có hàng hóa nào.</p>
}
else
{
    foreach (var hang in Model.Chunk(4))
    {
        <div class="section group">
            @foreach (var h in hang)
            {
                <div class="grid_1_of_4 images_1_of_4">
                    <a href="#"><img src="~/images/@(string.IsNullOrWhiteSpace(h.Anh) ? "logo.png" : h.Anh)" alt="@h.TenHang" /></a>
                    <h2>@h.TenHang</h2>
                    <div class="price-details">
                        <div class="price-number">
                            <p><span class="rupees">@(h.Gia?.ToString("N0") ?? "Liên hệ")</span></p>
                        </div>
                        <div class="add-cart">
                            <h4><a href="#">Add to Cart</a></h4>
                        </div>
                        <div class="clear"></div>
                    </div>
                </div>
            }
        </div>
    }
}
