@model HangHoa
@{
    ViewData["Title"] = "Thêm hàng hóa mới";
}

<div class="content_top">
    <div class="heading">
        <h3>@SinhVien.HoTen</h3>
    </div>
    <div class="see">
        <p><a asp-controller="Home" asp-action="Index">Về trang chủ</a></p>
    </div>
    <div class="clear"></div>
</div>

<div style="padding:20px">
    <h3>Thêm Hàng Hóa Mới</h3>
    <form asp-controller="HangHoa" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color:red"></div>

        <p style="margin-top:12px">
            <label asp-for="MaLoai"></label><br />
            <select asp-for="MaLoai" asp-items="(SelectList)ViewBag.MaLoai"></select>
        </p>
        <p style="margin-top:12px">
            <label asp-for="TenHang"></label><br />
            <input asp-for="TenHang" type="text" />
            <span asp-validation-for="TenHang" style="color:red"></span>
        </p>
        <p style="margin-top:12px">
            <label asp-for="Gia"></label><br />
            <input asp-for="Gia" type="text" />
            <span asp-validation-for="Gia" style="color:red"></span>
        </p>
        <p style="margin-top:12px">
            <label asp-for="Anh"></label><br />
            <input asp-for="Anh" type="text" />
            <span asp-validation-for="Anh" style="color:red"></span>
        </p>
        <p style="margin-top:12px"><button type="submit">Create</button></p>
    </form>
</div>
